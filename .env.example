# Copy to .env in the repository root. Never commit credentials.
ADAPTAI_OPENAI_MODEL=
ADAPTAI_OPENAI_API_KEY=
# Set true for models requiring the Responses API, including Codex models.
# Configure those model IDs through ADAPTAI_OPENAI_MODEL above.
ADAPTAI_OPENAI_USE_RESPONSES_API=false
# Claude uses a separate Anthropic API key and a compatible Claude model ID.
ADAPTAI_CLAUDE_MODEL=
ADAPTAI_ANTHROPIC_API_KEY=
# Groq serves the assessment model. Keep the key on the backend only.
ADAPTAI_GROQ_MODEL=openai/gpt-oss-20b
ADAPTAI_GROQ_API_KEY=
ADAPTAI_OLLAMA_MODEL=
ADAPTAI_TIMEOUT_SECONDS=30
# Persistent local database. Back up this file while the service is stopped.
ADAPTAI_DATABASE_PATH=backend/data/adaptai.sqlite3
ADAPTAI_SESSION_DAYS=7
# Set true behind HTTPS in deployment.
ADAPTAI_COOKIE_SECURE=false
# Exact browser origin allowed to write through cookie authentication.
ADAPTAI_BROWSER_ORIGIN=http://127.0.0.1:8443
# Optional path to the local master encryption key for personal provider credentials.
# Empty = alongside the SQLite database, with suffix .credentials.key. Never commit it.
ADAPTAI_CREDENTIALS_KEY_PATH=

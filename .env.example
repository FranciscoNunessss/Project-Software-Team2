# Copy to .env in the repository root. Never commit credentials.
ADAPTAI_OPENAI_MODEL=
ADAPTAI_OPENAI_API_KEY=
# Set true for models requiring the Responses API, including Codex models.
# Configure those model IDs through ADAPTAI_OPENAI_MODEL above.
ADAPTAI_OPENAI_USE_RESPONSES_API=false
# Claude uses a separate Anthropic API key and a compatible Claude model ID.
ADAPTAI_CLAUDE_MODEL=
ADAPTAI_ANTHROPIC_API_KEY=
# Groq serves the assessment model. Keep the key on the backend only.
ADAPTAI_GROQ_MODEL=openai/gpt-oss-20b
ADAPTAI_GROQ_API_KEY=
# OpenRouter has no project setting: each user configures their own key and model in LLM config.
ADAPTAI_OLLAMA_MODEL=
ADAPTAI_OLLAMA_BASE_URL=http://127.0.0.1:11434
# LM Studio local server (Developer tab > Start Server). Set the loaded model's identifier.
ADAPTAI_LMSTUDIO_MODEL=
ADAPTAI_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
ADAPTAI_TIMEOUT_SECONDS=30
# PostgreSQL. Start the local server with: docker compose up -d --wait postgres
# Supabase: use its PostgreSQL connection/pooler URL and append ?sslmode=require.
# Keep this URL on the backend only; it contains the database password.
ADAPTAI_DATABASE_URL=postgresql://adaptai:adaptai@127.0.0.1:55432/adaptai
# Dedicated schema; do not add it to the Supabase Data API's exposed schemas.
ADAPTAI_DATABASE_SCHEMA=adaptai
ADAPTAI_SESSION_DAYS=7
# Set true behind HTTPS in deployment.
ADAPTAI_COOKIE_SECURE=false
# Exact browser origin allowed to write through cookie authentication.
ADAPTAI_BROWSER_ORIGIN=http://127.0.0.1:8443
# Local cookie login remains the default. Cloud uses Supabase bearer tokens.
ADAPTAI_AUTH_MODE=local
ADAPTAI_SUPABASE_URL=
# Public publishable/legacy anon key, NEVER a Supabase secret/service_role key.
ADAPTAI_SUPABASE_PUBLISHABLE_KEY=
# Optional path to the local master encryption key for personal provider credentials.
# Empty = backend/data/adaptai.credentials.key (preserves the legacy local key).
ADAPTAI_CREDENTIALS_KEY_PATH=

# Optional Fernet key supplied as a secret in deployment; takes precedence over the key file.
# Preserve the same key when importing existing encrypted model credentials.
ADAPTAI_CREDENTIALS_KEY=

# Local Compose ports; kept separate from Vite's native development port 8443.
ADAPTAI_HTTP_PORT=8080
ADAPTAI_POSTGRES_PORT=55432
# Exact browser origin for containers; the native ADAPTAI_BROWSER_ORIGIN stays independent.
ADAPTAI_CONTAINER_BROWSER_ORIGIN=http://127.0.0.1:8080
# Compose uses .env for backend runtime settings only. An absent file is allowed for demo mode.
ADAPTAI_ENV_FILE=.env
# Containers reach local model servers on the host; localhost would refer to the container.
ADAPTAI_CONTAINER_OLLAMA_BASE_URL=http://host.docker.internal:11434
ADAPTAI_CONTAINER_LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1

# Layer 3 of ADR-014 A10: the project's own OpenRouter key, used ONLY to measure models no
# public leaderboard rates (never for chats). Empty: off. Without bought credit only free
# models run, within the daily calls; paid ones also need ADAPTAI_EVALUATION_PAID=true.
ADAPTAI_EVALUATION_OPENROUTER_KEY=
ADAPTAI_EVALUATION_DAILY_CALLS=50
ADAPTAI_EVALUATION_PAID=false
ADAPTAI_EVALUATION_BUDGET_USD=5
